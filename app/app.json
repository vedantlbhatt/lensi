{
  "expo": {
    "name": "Lensi",
    "slug": "lensi",
    "scheme": "lensi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vedantbhatt.lensi",
      "appleTeamId": "A4YA8NU8Y8",
      "infoPlist": {
        "NSCameraUsageDescription": "Lensi uses the camera to see and annotate what you point it at.",
        "UIRequiredDeviceCapabilities": [
          "arkit"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Lensi talks to your development server on the local network.",
        "NSMicrophoneUsageDescription": "Lensi listens while you hold the mic so you can ask about what the camera sees, and records sound with videos.",
        "NSSpeechRecognitionUsageDescription": "Lensi turns what you ask into text on this iPhone."
      },
      "config": {}
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
            "./node_modules/@expo-google-fonts/funnel-sans/400Regular/FunnelSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/funnel-sans/500Medium/FunnelSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/funnel-sans/600SemiBold/FunnelSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/funnel-sans/700Bold/FunnelSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/fragment-mono/400Regular/FragmentMono_400Regular.ttf",
            "./node_modules/@expo-google-fonts/instrument-serif/400Regular/InstrumentSerif_400Regular.ttf",
            "./node_modules/@expo-google-fonts/instrument-serif/400Regular_Italic/InstrumentSerif_400Regular_Italic.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lensi opens photos and videos you pick so it can annotate them.",
          "cameraPermission": "Lensi uses the camera to see and annotate what you point it at.",
          "microphonePermission": "Lensi listens while you hold the mic so you can ask about what the camera sees, and records sound with videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Lensi saves annotated images to your library when you ask it to.",
          "savePhotosPermission": "Lensi saves annotated images to your library when you ask it to.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#0B0B0C",
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#0B0B0C"
    }
  }
}
